# Server-side only — never expose to the browser bundle (no VITE_ prefix).
MISTRAL_API_KEY=

# Optional client AI preference: mock | http | auto
# Seeded into local settings on first run only.
VITE_AI_MODE=auto

# --- Vercel ---
# Set MISTRAL_API_KEY in Vercel Project → Settings → Environment Variables
# for Production (and Preview if desired). Never commit real keys.
