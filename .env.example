# Server-side only — never expose to the browser bundle (no VITE_ prefix).
MISTRAL_API_KEY=

# Optional client AI preference: mock | http | auto
# Seeded into local settings on first run only.
VITE_AI_MODE=auto

# --- Vercel ---
# Project → Settings → Environment Variables:
#   MISTRAL_API_KEY = <secret>   (Production + optional Preview)
# Never use a VITE_ prefix for the Mistral key.
# Without auth, enable Deployment Protection or accept AI proxy abuse risk.
# See README.md → Deploy on Vercel, and docs/POLISH_PROMPTS.md for follow-up agents.
